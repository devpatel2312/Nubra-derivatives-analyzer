# --- Nubra credentials (used by InitNubraSdk(env_creds=True)) ---
PHONE_NO="0000000000"
MPIN="0000"

# PROD or UAT  (ref_ids differ between the two - never mix them)
NUBRA_ENV=PROD

# Set to 1 to run with synthetic data (no login needed) - good for trying the UI
USE_MOCK=0

# Server
# For local dev: HOST=127.0.0.1
# For Render / cloud hosting: HOST=0.0.0.0
HOST=0.0.0.0
PORT=8000
